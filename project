function initCanvaEngine() {
  document.querySelectorAll('.drag-block').forEach(block => {
    if (block.dataset.canvaReady) return; // не переинициализируем уже готовые блоки
    block.dataset.canvaReady = '1';

    ['nw', 'ne', 'sw', 'se'].forEach(pos => {
      const h = document.createElement('div');
      h.className = `resize-handle handle-${pos}`;
      block.appendChild(h);

      h.onmousedown = function(e) {
        e.stopPropagation();
        if (!isEditMode) return;
        
        let startX = e.clientX, startY = e.clientY;
        let startW = block.offsetWidth, startH = block.offsetHeight;
        let startL = block.offsetLeft, startT = block.offsetTop;

        function onMouseMove(ev) {
          let dx = ev.clientX - startX;
          let dy = ev.clientY - startY;

          if (pos.includes('e')) block.style.width = Math.max(80, startW + dx) + 'px';
          if (pos.includes('s')) block.style.height = Math.max(35, startH + dy) + 'px';
          if (pos.includes('w')) {
            let nw = Math.max(80, startW - dx);
            block.style.width = nw + 'px';
            block.style.left = (startL + (startW - nw)) + 'px';
          }
          if (pos.includes('n')) {
            let nh = Math.max(35, startH - dy);
            block.style.height = nh + 'px';
            block.style.top = (startT + (startH - nh)) + 'px';
          }
        }

        function onMouseUp() {
          document.removeEventListener('mousemove', onMouseMove);
          document.removeEventListener('mouseup', onMouseUp);
        }
        document.addEventListener('mousemove', onMouseMove);
        document.addEventListener('mouseup', onMouseUp);
      };
    });

    block.onmousedown = function(e) {
      if (e.button !== 0) return; // ПКМ не должна тащить блок
      if (!isEditMode || e.target.classList.contains('resize-handle')) return;

      let shiftX = e.clientX - block.getBoundingClientRect().left;
      let shiftY = e.clientY - block.getBoundingClientRect().top;
      const canvas = document.getElementById('mainCanvas');

      function moveAt(pageX, pageY) {
        let rect = canvas.getBoundingClientRect();
        block.style.left = Math.max(0, pageX - rect.left - shiftX) + 'px';
        block.style.top = Math.max(0, pageY - rect.top - shiftY) + 'px';
      }

      function onMouseMove(ev) { moveAt(ev.pageX, ev.pageY); }
      document.addEventListener('mousemove', onMouseMove);

      document.onmouseup = function() {
        document.removeEventListener('mousemove', onMouseMove);
        document.onmouseup = null;
      };
    };

    block.oncontextmenu = function(e) {
      if (!isEditMode) return;
      if (e.target.closest && e.target.closest('.card')) return; // ячейкой блюда занимается её собственный обработчик
      e.preventDefault();
      imageTarget = { type: 'block', el: block };
      showCustomContextMenu(e.pageX, e.pageY);
    };
  });
}

