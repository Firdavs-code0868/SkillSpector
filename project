function renderHistoryTable(startDate = null, endDate = null) {
  const tbody = document.getElementById('historyTableBody');
  tbody.innerHTML = '';

  let filteredHistory = receiptHistory;

  if (startDate && endDate) {
    const start = new Date(startDate);
    const end = new Date(endDate);
    end.setHours(23, 59, 59, 999);

    filteredHistory = receiptHistory.filter(rec => {
      const recDate = new Date(rec.isoDate || Date.now());
      return recDate >= start && recDate <= end;
    });
  }

  if (!filteredHistory.length) {
    tbody.innerHTML = '<tr><td colspan="8" style="text-align:center; color:var(--muted);">За данный период чеков не найдено.</td></tr>';
    document.getElementById('historyPeriodProfit').textContent = 'Выручка за период: 0 сум';
    return;
  }

  let periodProfit = 0;
  filteredHistory.forEach((rec) => {
    periodProfit += rec.total;
    const itemsStr = rec.items.map(i => `${i.name} (x${i.qty})`).join(', ');
    const tr = document.createElement('tr');
    tr.innerHTML = `
      <td><b>#${rec.id}</b></td>
      <td>${rec.date}</td>
      <td>${rec.table ? '№' + rec.table : '-'}</td>
      <td>${rec.client || '-'}</td>
      <td>${rec.phone || '-'}</td>
      <td>${itemsStr}</td>
      <td>${rec.service.toLocaleString()} сум</td>
      <td><b>${rec.total.toLocaleString()} сум</b></td>
    `;
    tbody.appendChild(tr);
  });

  document.getElementById('historyPeriodProfit').textContent = `Выручка за выбранный период: ${periodProfit.toLocaleString()} сум`;

  // Подсчет выручки за текущий день для главного экрана
  const todayStr = new Date().toLocaleDateString('ru-RU');
  const todayProfit = receiptHistory
    .filter(r => r.date.includes(todayStr))
    .reduce((acc, r) => acc + r.total, 0);
  document.getElementById('todayProfitVal').textContent = todayProfit.toLocaleString() + ' сум';
}

