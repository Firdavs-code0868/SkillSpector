function getLastNDaysProfits(n) {
  const days = [];
  const now = new Date();
  for (let i = n - 1; i >= 0; i--) {
    const d = new Date(now);
    d.setDate(now.getDate() - i);
    const key = d.toLocaleDateString('ru-RU');
    days.push({ key, label: d.toLocaleDateString('ru-RU', { day: '2-digit', month: '2-digit' }), total: 0 });
  }
  receiptHistory.forEach(rec => {
    const recDateKey = new Date(rec.isoDate || Date.now()).toLocaleDateString('ru-RU');
    const dayObj = days.find(d => d.key === recDateKey);
    if (dayObj) dayObj.total += rec.total;
  });
  return days;
}

function renderProfitChart() {
  const days = getLastNDaysProfits(7);
  const maxVal = Math.max(...days.map(d => d.total), 1);
  const barWidth = 40;
  const chartWidth = Math.max(560, days.length * 90);
  const chartHeight = 240;
  const baseline = chartHeight - 40;
  const gap = (chartWidth - barWidth * days.length) / (days.length + 1);

  let bars = '';
  const points = [];
  days.forEach((d, idx) => {
    const barHeight = Math.round((d.total / maxVal) * 160);
    const x = gap + idx * (barWidth + gap);
    const y = baseline - barHeight;
    const isToday = idx === days.length - 1;
    const color = isToday ? 'var(--orange)' : 'var(--purple)';
    bars += `
      <rect x="${x}" y="${y}" width="${barWidth}" height="${Math.max(barHeight,2)}" rx="8" fill="${color}" opacity="0.85"/>
      <text x="${x + barWidth / 2}" y="${baseline + 18}" text-anchor="middle" font-size="11" fill="var(--muted)" font-family="Inter, sans-serif">${d.label}</text>
      <text x="${x + barWidth / 2}" y="${y - 8}" text-anchor="middle" font-size="10" fill="var(--ink)" font-family="JetBrains Mono, monospace">${d.total > 0 ? Math.round(d.total / 1000) + 'k' : '0'}</text>
    `;
    points.push([x + barWidth / 2, y]);
  });

  const linePoints = points.map(p => p.join(',')).join(' ');
  const dots = points.map(p => `<circle cx="${p[0]}" cy="${p[1]}" r="4" fill="var(--green)"/>`).join('');

  const svg = `
    <svg viewBox="0 0 ${chartWidth} ${chartHeight}" width="100%" height="${chartHeight}" xmlns="http://www.w3.org/2000/svg">
      <line x1="0" y1="${baseline}" x2="${chartWidth}" y2="${baseline}" stroke="var(--line)" stroke-width="1.5"/>
      ${bars}
      <polyline points="${linePoints}" fill="none" stroke="var(--green)" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round"/>
      ${dots}
    </svg>
  `;
  document.getElementById('profitChartWrap').innerHTML = svg;

  // Тренд: сегодня против вчера
  const today = days[days.length - 1].total;
  const yesterday = days[days.length - 2] ? days[days.length - 2].total : 0;
  const badge = document.getElementById('profitTrendBadge');
  if (today > yesterday) {
    const diffPct = yesterday > 0 ? Math.round(((today - yesterday) / yesterday) * 100) : 100;
    badge.textContent = `📈 Рост на ${diffPct}% по сравнению со вчера`;
    badge.style.background = 'rgba(31,157,85,0.15)';
    badge.style.color = 'var(--green)';
  } else if (today < yesterday) {
    const diffPct = yesterday > 0 ? Math.round(((yesterday - today) / yesterday) * 100) : 100;
    badge.textContent = `📉 Падение на ${diffPct}% по сравнению со вчера`;
    badge.style.background = 'rgba(225,72,72,0.15)';
    badge.style.color = 'var(--red)';
  } else {
    badge.textContent = `➖ Без изменений по сравнению со вчера`;
    badge.style.background = 'rgba(138,127,118,0.15)';
    badge.style.color = 'var(--muted)';
  }

  // Сводка
  const weekTotal = days.reduce((acc, d) => acc + d.total, 0);
  const avgDaily = Math.round(weekTotal / days.length);
  const bestDay = days.reduce((a, b) => (b.total > a.total ? b : a), days[0]);
  const summaryGrid = document.getElementById('profitSummaryGrid');
  summaryGrid.innerHTML = `
    <div style="background:var(--purple-soft); padding:14px; border-radius:12px; backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);">
      <div style="font-size:11px; color:var(--muted); font-weight:600; text-transform:uppercase;">Сегодня</div>
      <div style="font-size:18px; font-weight:700; margin-top:4px;">${today.toLocaleString()} сум</div>
    </div>
    <div style="background:var(--purple-soft); padding:14px; border-radius:12px; backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);">
      <div style="font-size:11px; color:var(--muted); font-weight:600; text-transform:uppercase;">За 7 дней</div>
      <div style="font-size:18px; font-weight:700; margin-top:4px;">${weekTotal.toLocaleString()} сум</div>
    </div>
    <div style="background:var(--purple-soft); padding:14px; border-radius:12px; backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);">
      <div style="font-size:11px; color:var(--muted); font-weight:600; text-transform:uppercase;">Среднее в день</div>
      <div style="font-size:18px; font-weight:700; margin-top:4px;">${avgDaily.toLocaleString()} сум</div>
    </div>
    <div style="background:var(--purple-soft); padding:14px; border-radius:12px; backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);">
      <div style="font-size:11px; color:var(--muted); font-weight:600; text-transform:uppercase;">Лучший день</div>
      <div style="font-size:18px; font-weight:700; margin-top:4px;">${bestDay.label}: ${bestDay.total.toLocaleString()} сум</div>
    </div>
  `;
}

