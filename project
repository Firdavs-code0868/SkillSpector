<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Кассовый аппарат c Конструктором</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<style>
  :root{
    --orange:#A5B4FC;
    --orange-dark:#818CF8;
    --purple:#7C7FF7;
    --purple-dark:#5B5FE8;
    --purple-glow: rgba(124,127,247,.55);
    --purple-soft: rgba(124,127,247,.14);
    --cream:#0B0B22;
    --paper: rgba(255,255,255,.05);
    --ink:#F2F1FB;
    --muted:#9C9AC4;
    --line: rgba(255,255,255,.14);
    --green:#34D399;
    --red:#F87171;
    --card-bg: rgba(255,255,255,.055);
    --input-bg: rgba(255,255,255,.06);
    --glass-blur: 18px;
    --glass-border: rgba(255,255,255,.16);
  }

  body.dark-theme {
    --cream:#050510;
    --paper: rgba(255,255,255,.035);
    --ink:#F2F1FB;
    --muted:#8987B5;
    --line: rgba(255,255,255,.1);
    --card-bg: rgba(255,255,255,.035);
    --input-bg: rgba(255,255,255,.04);
    --glass-border: rgba(255,255,255,.1);
  }

  *{box-sizing:border-box;}
  body{
    margin:0; min-height:100vh; color:var(--ink); font-family:'Inter',sans-serif;
    transition: background 0.4s, color 0.3s; user-select:none;
    background: #05030b;
  }
  body.dark-theme{
    background: #020108;
  }
  h1,h2,h3,.brand-name,.tabbtn{font-family:'Fredoka',sans-serif;}

  header.top{
    background: rgba(255,255,255,.05);
    backdrop-filter: blur(var(--glass-blur)) saturate(160%);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(160%);
    border:1px solid var(--glass-border);
    margin:16px 20px 0; border-radius:22px;
    padding:14px 24px; display:flex; align-items:center; gap:12px;
    box-shadow:0 8px 32px rgba(0,0,0,.35), inset 0 1px 0 rgba(255,255,255,.06);
    position:sticky; top:16px; z-index:50;
  }
  .brand-wrap{display:flex; flex-direction:column; gap:2px; flex:1;}
  .brand-name{ color:#fff; font-size:22px; font-weight:700; background:transparent; border:none; outline:none; }
  .brand-sub{ color:rgba(255,255,255,.6); font-size:12.5px; background:transparent; border:none; outline:none; }

  .header-btn {
    background: rgba(255,255,255,0.07); border: 1px solid var(--glass-border);
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    color: #fff; padding: 8px 16px; border-radius: 30px; font-weight: 600;
    cursor: pointer; display: flex; align-items: center; gap: 6px; font-size: 13px; transition: 0.2s;
  }
  .header-btn:hover { background: rgba(255,255,255,0.28); }

  /* ХОЛСТ ГЛАВНОГО ЭКРАНА */
  .main-canvas {
    position: relative; width: 100%; min-height: 90vh; padding: 24px 28px;
    max-width: none; margin: 0;
  }

  /* ВСЕ ПЕРЕТАСКИВАЕМЫЕ БЛОКИ */
  .drag-block {
    position: absolute; z-index: 10; transition: box-shadow 0.2s;
  }

  /* РЕЖИМ РЕДАКТИРОВАНИЯ ЭКРАНА */
  body.edit-mode .drag-block {
    outline: 2px dashed var(--purple); outline-offset: 4px; cursor: move !important;
  }
  body.edit-mode .drag-block:active { opacity: 0.9; z-index: 100; }
  body.edit-mode .card { cursor: context-menu !important; }

  /* УГЛОВЫЕ РУЧКИ РЕСАЙЗА */
  .resize-handle {
    display: none; position: absolute; width: 12px; height: 12px; background: var(--purple);
    border: 2px solid #fff; border-radius: 50%; z-index: 101;
  }
  body.edit-mode .drag-block .resize-handle { display: block; }
  .handle-nw { top: -6px; left: -6px; cursor: nwse-resize; }
  .handle-ne { top: -6px; right: -6px; cursor: nesw-resize; }
  .handle-sw { bottom: -6px; left: -6px; cursor: nesw-resize; }
  .handle-se { bottom: -6px; right: -6px; cursor: nwse-resize; }

  .profit-card {
    background:linear-gradient(135deg, rgba(22,163,74,.55) 0%, rgba(21,121,64,.6) 100%);
    backdrop-filter: blur(var(--glass-blur)) saturate(160%);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(160%);
    border:1px solid rgba(255,255,255,.35);
    color:#fff; padding:12px 18px; border-radius:16px; cursor:pointer;
    box-shadow:0 8px 24px rgba(21,121,64,.25); width: 100%; height: 100%;
  }
  .profit-card:hover { filter: brightness(1.08); }
  .profit-card .p-title { font-size:11px; font-weight:600; text-transform:uppercase; opacity:.9; }
  .profit-card .p-val { font-family:'Fredoka',sans-serif; font-size:19px; font-weight:700; margin-top:2px; }

  .tabbtn{
    display:inline-flex; align-items:center; justify-content:center; gap:8px;
    background:var(--card-bg); border:1.5px solid var(--glass-border);
    backdrop-filter: blur(var(--glass-blur)) saturate(160%);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(160%);
    padding:10px 18px; border-radius:16px;
    cursor:pointer; font-weight:600; font-size:14px; color:var(--ink); width: 100%; height: 100%;
    position:relative; overflow:hidden; transition: background .2s, box-shadow .2s;
  }
  .tabbtn.active{
    background:linear-gradient(135deg, rgba(124,127,247,.75) 0%, rgba(91,95,232,.8) 100%);
    color:#fff; border-color:rgba(255,255,255,.4); box-shadow:0 8px 20px rgba(124,127,247,.4);
  }
  .tabbtn img.custom-icon { width: 22px; height: 22px; object-fit: cover; border-radius: 4px; }

  /* СТИКЕР -> КРУПНАЯ КАРТИНКА НА ВСЮ ЯЧЕЙКУ */
  .icon-wrap{ display:inline-flex; align-items:center; justify-content:center; }
  .icon-wrap.icon-fill{
    position:absolute; inset:0; width:100%; height:100%; z-index:0;
    border-radius:inherit; overflow:hidden; display:flex;
  }
  .icon-wrap.icon-fill img.custom-icon{
    width:100%; height:100%; object-fit:cover; border-radius:inherit;
  }
  .tabbtn > span:not(.icon-wrap){ position:relative; z-index:1; }
  .tabbtn.has-bg-image{ border-color: transparent; }
  .tabbtn.has-bg-image > span:not(.icon-wrap){
    background:rgba(0,0,0,.55); color:#fff; padding:3px 9px; border-radius:8px; backdrop-filter: blur(1px);
  }

  .grid{ display:grid; grid-template-columns:repeat(auto-fill,minmax(140px,1fr)); gap:14px; width: 100%; }
  .card{
    background:var(--card-bg); border:1px solid var(--glass-border); border-radius:18px;
    backdrop-filter: blur(var(--glass-blur)) saturate(160%);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(160%);
    box-shadow: 0 8px 24px rgba(124,127,247,.10);
    padding:14px; cursor:pointer; display:flex; flex-direction:column; gap:8px; min-height:140px;
    transition:transform .12s, box-shadow .12s; overflow:hidden;
  }
  .card:hover{ transform:translateY(-3px); box-shadow: 0 14px 30px rgba(124,127,247,.22); }
  .card .media-box {
    width: 100%; height: 70px; border-radius: 12px; overflow: hidden;
    background: var(--purple-soft); display: flex; align-items: center; justify-content: center;
  }
  .card .media-box img { width: 100%; height: 100%; object-fit: cover; }
  .card .media-box .emoji-text { font-size: 32px; }
  .card .name{ font-weight:600; font-size:13px; color:var(--ink); }
  .card .price{ margin-top:auto; font-weight:700; color:var(--orange-dark); font-size:13px; }

  /* ЧЕК */
  .receipt-shell{
    width: 100%; height: 100%; background:var(--paper); border:1px solid var(--glass-border); border-radius:16px;
    backdrop-filter: blur(var(--glass-blur)) saturate(160%);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(160%);
    padding:20px; box-shadow:0 14px 36px rgba(124,127,247,.16); display:flex; flex-direction:column; overflow-y: auto;
  }
  .receipt-shell.sealed {
    border: 2px solid var(--red);
    background: rgba(239, 68, 68, 0.06);
  }
  .r-brand{ font-family:'Fredoka',sans-serif; font-weight:700; font-size:18px; text-align:center; }
  .r-sub{ text-align:center; font-size:11.5px; color:var(--muted); }
  .r-datetime{ text-align:center; font-size:11px; color:var(--muted); font-family:'JetBrains Mono',monospace; margin-top:2px; }
  .r-divider{ border:none; border-top:1.5px dashed var(--line); margin:10px 0; }
  
  .client-inputs-box{
    display:grid; grid-template-columns:1fr 1fr; gap:8px; margin-top:6px;
    background:var(--purple-soft); padding:8px; border-radius:12px; border:1px solid var(--line);
  }
  .client-inputs-box input{
    width:100%; border:1.5px solid var(--line); border-radius:8px; padding:6px;
    font-size:11px; font-family:'Inter',sans-serif; background:var(--input-bg); color:var(--ink); outline:none;
  }
  .client-inputs-box input.field-error{ border-color:var(--red); background:rgba(239,68,68,.1); }

  /* КРАСНОЕ ПРЕДУПРЕЖДЕНИЕ О ПУСТЫХ ПОЛЯХ */
  .required-warn{
    display:none; margin-top:8px; padding:8px 10px; border-radius:10px;
    background:rgba(239,68,68,.14); border:1px solid var(--red);
    color:var(--red); font-size:12px; font-weight:700; text-align:center;
  }
  .required-warn.show{ display:block; }

  /* ДАННЫЕ КЛИЕНТА В ЧЕКЕ */
  .client-summary{
    margin-top:8px; font-family:'JetBrains Mono',monospace; font-size:11.5px; line-height:1.6;
  }
  .client-summary .cs-row{ display:flex; justify-content:space-between; gap:8px; }
  .client-summary .cs-label{ color:var(--muted); }  /* СПИСОК УДАЛЕНИЯ КАТЕГОРИЙ И ЯЧЕЕК */
  .manage-cat{ border:1px solid var(--line); border-radius:12px; padding:12px; margin-bottom:12px; background:var(--purple-soft); }
  .manage-cat-head{ display:flex; justify-content:space-between; align-items:center; gap:10px; margin-bottom:8px; }
  .manage-dish{ display:flex; justify-content:space-between; align-items:center; gap:10px; padding:6px 0; border-top:1px dashed var(--line); font-size:13px; }
  .btn-del{ background:var(--red); color:#fff; border:none; border-radius:8px; padding:6px 12px; font-weight:600; cursor:pointer; font-size:12px; }

  .r-items{ min-height:70px; font-family:'JetBrains Mono',monospace; font-size:12px; }
  .r-empty{ color:var(--muted); text-align:center; padding:15px 0; font-size:12px; }
  .r-row{ display:flex; justify-content:space-between; padding:4px 0; border-bottom:1px dashed var(--line); }
  .r-line{ display:flex; justify-content:space-between; font-family:'JetBrains Mono',monospace; font-size:12px; padding:2px 0; }
  .r-line.grand{ font-size:15px; font-weight:700; color:var(--ink); padding-top:4px; }

  .r-footer-msg { text-align: center; font-size: 11px; color: var(--muted); margin-top: 10px; font-style: italic; }

  .r-actions{ display:flex; gap:8px; margin-top:10px; }
  .btn{ flex:1; border:none; border-radius:10px; padding:10px; font-weight:700; font-size:13px; cursor:pointer; }
  .btn-print{ background:linear-gradient(135deg, var(--purple) 0%, var(--purple-dark) 100%); color:#fff; box-shadow:0 6px 16px rgba(91,95,232,.4); }
  .btn-print:disabled{ background:var(--line); color:var(--muted); cursor:not-allowed; box-shadow:none; }
  .btn-sealed{ background:var(--red) !important; color:#fff !important; cursor:not-allowed; }
  .btn-new{ background:var(--card-bg); color:var(--ink); border:1px solid var(--line); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); }

  /* ПАНЕЛЬ УПРАВЛЕНИЯ РЕДАКТИРОВАНИЕМ */
  .edit-bar-banner {
    position: fixed; bottom: 20px; left: 50%; transform: translateX(-50%);
    background: rgba(30,20,55,.55); color: #fff; padding: 12px 24px; border-radius: 50px;
    backdrop-filter: blur(var(--glass-blur)) saturate(160%); -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(160%);
    box-shadow: 0 10px 30px rgba(0,0,0,0.35); display: none; align-items: center; gap: 16px;
    z-index: 10000; border: 1.5px solid rgba(124,127,247,.45); font-size: 13px;
  }
  .edit-bar-banner.show { display: flex; }
  .btn-save-layout {
    background: var(--green); color: #fff; border: none; padding: 8px 18px;
    border-radius: 30px; font-weight: 700; cursor: pointer; font-size: 13px;
  }

  .toast-notification {
    position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%) scale(0.8);
    background: rgba(30,20,55,.6); color: #fff; padding: 16px 24px; border-radius: 16px;
    backdrop-filter: blur(var(--glass-blur)) saturate(160%); -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(160%);
    font-size: 14px; font-weight: 700; box-shadow: 0 10px 30px rgba(0,0,0,0.3);
    z-index: 20000; opacity: 0; pointer-events: none; transition: all 0.25s ease;
    display: flex; align-items: center; gap: 10px; border: 1.5px solid rgba(124,127,247,.45);
  }
  .toast-notification.show { opacity: 1; transform: translate(-50%, -50%) scale(1); }

  /* КОНТЕКСТНОЕ МЕНЮ ДЛЯ СМЕНЫ СТИКЕРА */
  .custom-context-menu {
    position: fixed; z-index: 10001; background: var(--card-bg); border: 1px solid var(--glass-border);
    backdrop-filter: blur(var(--glass-blur)) saturate(160%); -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(160%);
    border-radius: 12px; box-shadow: 0 12px 30px rgba(124,127,247,.28); padding: 6px;
    display: none; min-width: 230px; overflow: hidden;
  }
  .custom-context-menu.show { display: block; }
  .custom-context-menu .menu-item {
    padding: 11px 14px; font-size: 13px; font-weight: 600; cursor: pointer;
    border-radius: 8px; display: flex; align-items: center; gap: 10px; color: var(--ink);
  }
  .custom-context-menu .menu-item:hover { background: var(--purple-soft); color: var(--purple); }
  .custom-context-menu .menu-divider { border: none; border-top: 1px solid var(--line); margin: 4px 0; }

  .overlay{
    position:fixed; inset:0; z-index:999; display:none; flex-direction:column; overflow-y:auto; color:var(--ink);
    background: rgba(5,3,11,.82);
    backdrop-filter: blur(30px) saturate(160%); -webkit-backdrop-filter: blur(30px) saturate(160%);
  }
  body.dark-theme .overlay{
    background: rgba(2,1,8,.88);
  }
  .overlay.show{ display:flex; }
  .fs-header{
    background:var(--card-bg); border-bottom:1px solid var(--glass-border); padding:16px 28px;
    backdrop-filter: blur(var(--glass-blur)) saturate(160%); -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(160%);
    display:flex; justify-content:space-between; align-items:center; position:sticky; top:0; z-index:5;
  }
  .fs-body{ padding:28px; max-width:1000px; width:100%; margin:0 auto; }  .setting-section {
    background: var(--card-bg); border: 1px solid var(--glass-border); border-radius: 16px; padding: 20px; margin-bottom: 20px;
    backdrop-filter: blur(var(--glass-blur)) saturate(160%); -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(160%);
    box-shadow: 0 8px 24px rgba(124,127,247,.10);
  }
  .setting-section h3 { margin-top: 0; color: var(--purple); font-size: 18px; }
  
  .form-group { margin-bottom: 12px; }
  .form-group label { display: block; font-size: 12px; font-weight: 600; margin-bottom: 4px; color: var(--muted); }
  .form-group input, .form-group select {
    width: 100%; padding: 10px; border: 1px solid var(--line); border-radius: 8px;
    font-family: inherit; font-size: 13px; background: var(--input-bg); color: var(--ink); outline: none;
  }
  .btn-action { background: linear-gradient(135deg, var(--purple) 0%, var(--purple-dark) 100%); color: #fff; padding: 10px 16px; border: none; border-radius: 8px; font-weight: 600; cursor: pointer; box-shadow:0 6px 14px rgba(91,95,232,.35); }

  /* ТАБЛИЦА ИСТОРИИ ЧЕКОВ */
  .history-table { width: 100%; border-collapse: collapse; margin-top: 10px; }
  .history-table th, .history-table td { padding: 10px; border-bottom: 1px solid var(--line); text-align: left; font-size: 13px; }
  .history-table th { background: var(--purple-soft); font-weight: 600; }

  /* СТИЛИ ДЛЯ ПЕЧАТИ ЧЕКА */
  @media print {
    body * { visibility: hidden; }
    #printableReceipt, #printableReceipt * { visibility: visible; }
    #printableReceipt {
      position: absolute; left: 0; top: 0; width: 80mm; padding: 20px;
      font-family: 'JetBrains Mono', monospace; font-size: 16px; line-height: 1.6; color: #000;
    }
  }

  /* ===== КАСТОМНОЕ ОКНО ПОДТВЕРЖДЕНИЯ ===== */
  .confirm-overlay{
    position:fixed; inset:0; background:rgba(5,3,11,.12);
    backdrop-filter:blur(18px) saturate(140%); -webkit-backdrop-filter:blur(18px) saturate(140%);
    display:flex; align-items:center; justify-content:center;
    z-index:9999; opacity:0; pointer-events:none; transition:opacity .18s ease;
  }
  .confirm-overlay.show{ opacity:1; pointer-events:auto; }
  .confirm-box{
    background:rgba(13,7,22,.32); color:var(--ink);
    backdrop-filter: blur(28px) saturate(170%); -webkit-backdrop-filter: blur(28px) saturate(170%);
    width:min(92vw,430px); border-radius:22px; padding:26px 24px 20px;
    box-shadow:0 24px 60px rgba(40,20,70,.35), inset 0 1px 0 rgba(255,255,255,.08), 0 0 0 1px rgba(255,255,255,.08); border:1px solid rgba(255,255,255,.18);
    transform:translateY(14px) scale(.96); transition:transform .2s cubic-bezier(.2,.9,.3,1.3);
    text-align:center;
  }
  .confirm-overlay.show .confirm-box{ transform:translateY(0) scale(1); }
  .confirm-icon{
    width:62px; height:62px; margin:0 auto 14px; border-radius:50%;
    display:flex; align-items:center; justify-content:center; font-size:30px;
    background:rgba(239,68,68,.14);
  }
  .confirm-box.type-info .confirm-icon{ background:var(--purple-soft); }
  .confirm-title{ font-family:'Fredoka',sans-serif; font-size:20px; font-weight:700; margin:0 0 8px; }
  .confirm-text{ font-size:14.5px; color:var(--muted); line-height:1.5; margin:0 0 22px; }
  .confirm-text b{ color:var(--ink); }
  .confirm-actions{ display:flex; gap:10px; }
  .confirm-actions button{
    flex:1; padding:13px 10px; border-radius:14px; font-size:15px; font-weight:700;
    font-family:'Inter',sans-serif; cursor:pointer; border:none; transition:.15s;
  }
  .confirm-cancel{ background:transparent; color:var(--ink); border:1.5px solid var(--line) !important; }
  .confirm-cancel:hover{ background:var(--line); }
  .confirm-ok{ background:var(--red); color:#fff; box-shadow:0 6px 16px rgba(239,68,68,.3); }
  .confirm-ok:hover{ filter:brightness(1.08); }
  .confirm-box.type-info .confirm-ok{ background:linear-gradient(135deg, var(--purple) 0%, var(--purple-dark) 100%); box-shadow:0 6px 16px rgba(124,127,247,.4); }

/* ===== GLOBAL WATER BACKGROUND (живой на всех экранах) ===== */
#globalWaterBg{position:fixed;inset:0;z-index:-1;overflow:hidden;background:#05030b}
#globalWaterBg .water-bg{position:absolute;inset:-20%;background:radial-gradient(circle at 20% 20%,rgba(255,40,150,.35),transparent 30%),radial-gradient(circle at 80% 30%,rgba(80,70,255,.4),transparent 34%),radial-gradient(circle at 45% 85%,rgba(190,0,255,.3),transparent 35%),linear-gradient(135deg,#05020b,#16051f 48%,#030516);filter:blur(2px);animation:waterMove 6s ease-in-out infinite alternate}
#globalWaterBg .water-bg:before,#globalWaterBg .water-bg:after{content:'';position:absolute;width:75vw;height:75vw;border-radius:45% 55% 60% 40%;border:2px solid rgba(255,255,255,.09);box-shadow:0 0 80px rgba(185,30,255,.25),inset 0 0 70px rgba(255,0,160,.14);animation:liquid 7s linear infinite}
#globalWaterBg .water-bg:after{width:55vw;height:55vw;animation-duration:9s;animation-direction:reverse;border-color:rgba(100,120,255,.14)}
#globalWaterBg .water-dots{position:absolute;inset:0;pointer-events:none;opacity:.35;background-image:radial-gradient(circle,rgba(255,255,255,.32) 1px,transparent 1px);background-size:34px 34px;animation:dots 10s linear infinite}
#globalWaterBg .water-blob{position:absolute;border-radius:50%;opacity:.45;mix-blend-mode:screen;filter:blur(60px)}
#globalWaterBg .blob1{width:50vw;height:50vw;left:-10%;top:-10%;background:radial-gradient(circle,rgba(236,72,153,.9) 0%,transparent 70%);animation:blobDrift1 8s ease-in-out infinite}
#globalWaterBg .blob2{width:55vw;height:55vw;right:-15%;top:5%;background:radial-gradient(circle,rgba(99,102,241,.85) 0%,transparent 70%);animation:blobDrift2 10s ease-in-out infinite;animation-delay:-3s}
#globalWaterBg .blob3{width:45vw;height:45vw;left:15%;bottom:-15%;background:radial-gradient(circle,rgba(139,92,246,.85) 0%,transparent 70%);animation:blobDrift3 9s ease-in-out infinite;animation-delay:-6s}
#globalWaterBg .blob4{width:40vw;height:40vw;right:5%;bottom:-10%;background:radial-gradient(circle,rgba(244,63,94,.7) 0%,transparent 70%);animation:blobDrift4 7s ease-in-out infinite;animation-delay:-1s}
@keyframes blobDrift1{0%,100%{transform:translate(0,0) scale(1)}33%{transform:translate(8vw,6vh) scale(1.2)}66%{transform:translate(-4vw,10vh) scale(0.9)}}
