<div class="confirm-overlay" id="authVerifyOverlay">
  <div class="confirm-box" id="authVerifyBox" style="text-align:left;background:rgba(13,7,22,.32);border:1px solid rgba(255,255,255,.18);box-shadow:0 24px 60px rgba(40,20,70,.35), inset 0 1px 0 rgba(255,255,255,.08), 0 0 0 1px rgba(255,255,255,.08);">
    <h3 class="confirm-title" style="text-align:center;">🔐 Введите логин и пароль</h3>
    <div class="form-group">
      <label>Логин</label>
      <input type="text" id="authVerifyUser" autocomplete="off" />
    </div>
    <div class="form-group">
      <label>Пароль</label>
      <input type="password" id="authVerifyPass" autocomplete="off" />
    </div>
    <div class="auth-modal-error" id="authVerifyError">Неверный логин или пароль</div>
    <div class="confirm-actions">
      <button class="confirm-cancel" id="authVerifyCancelBtn">Отмена</button>
      <button class="confirm-ok" id="authVerifyOkBtn" style="background:var(--purple); box-shadow:0 6px 16px rgba(124,127,247,.4);">Подтвердить</button>
    </div>
  </div>
</div>

<!-- ОКНО ИЗМЕНЕНИЯ ЛОГИНА И ПАРОЛЯ -->
<div class="confirm-overlay" id="authChangeOverlay">
  <div class="confirm-box" id="authChangeBox" style="text-align:left;background:rgba(13,7,22,.32);border:1px solid rgba(255,255,255,.18);box-shadow:0 24px 60px rgba(40,20,70,.35), inset 0 1px 0 rgba(255,255,255,.08), 0 0 0 1px rgba(255,255,255,.08);">
    <h3 class="confirm-title" style="text-align:center;">🔑 Изменить логин и пароль</h3>
    <div class="form-group">
      <label>Новый логин</label>
      <input type="text" id="authNewUser" autocomplete="off" />
    </div>
    <div class="form-group">
      <label>Новый пароль</label>
      <input type="password" id="authNewPass" autocomplete="off" />
    </div>
    <div class="form-group">
      <label>Повторите новый пароль</label>
      <input type="password" id="authNewPass2" autocomplete="off" />
    </div>
    <div class="auth-modal-error" id="authChangeError">Пароли не совпадают</div>
    <div class="confirm-actions">
      <button class="confirm-cancel" id="authChangeCancelBtn">Отмена</button>
      <button class="confirm-ok" id="authChangeSaveBtn" style="background:var(--purple); box-shadow:0 6px 16px rgba(124,127,247,.4);">Сохранить</button>
    </div>
  </div>
</div>

<script>
/* ===== FIRDAVS AUTH: username / password с localStorage ===== */
(function(){
  const AUTH_KEY = 'firdavs_auth_v1';
  function getCreds(){
    try{
      const raw = localStorage.getItem(AUTH_KEY);
      if(raw){ const o=JSON.parse(raw); if(o&&o.user&&o.pass) return o; }
    }catch(e){}
    return { user:'firdavs', pass:'11111111' };
  }
  function setCreds(user,pass){ localStorage.setItem(AUTH_KEY, JSON.stringify({user,pass})); }

  let creds = getCreds();
  const lock=document.getElementById('firdavsLockBtn');
  const screen=document.getElementById('firdavsLogin');
  const orb=document.getElementById('loginOrb');
  const user=document.getElementById('firdavsUser');
  const pass=document.getElementById('firdavsPass');
  const btn=document.getElementById('firdavsLoginBtn');
  const err=document.getElementById('firdavsError');
  const eye=document.getElementById('firdavsEye');

  function showLogin(){
    document.body.classList.remove('app-visible'); document.body.classList.add('login-locked');
    screen.style.display='flex'; screen.setAttribute('aria-hidden','false'); user.value=''; pass.value=''; err.classList.remove('show');
    setTimeout(()=>user.focus(),120);
  }
  function unlock(){
    document.body.classList.remove('login-locked'); document.body.classList.add('app-visible');
    screen.style.display='none'; screen.setAttribute('aria-hidden','true');
  }
  function check(){
    if(user.value.trim()===creds.user && pass.value===creds.pass){
      err.classList.remove('show');
      orb.animate([{transform:'scale(1)'},{transform:'scale(1.06)'},{transform:'scale(0.2)',opacity:0}],{duration:430,easing:'ease-in'}).onfinish=unlock;
    }else{
      err.classList.add('show'); orb.classList.remove('login-shake'); void orb.offsetWidth; orb.classList.add('login-shake'); pass.select();
    }
  }
  btn.addEventListener('click',check);
  [user,pass].forEach(x=>x.addEventListener('keydown',e=>{if(e.key==='Enter')check()}));
  eye.addEventListener('click',()=>{pass.type=pass.type==='password'?'text':'password';eye.textContent=pass.type==='password'?'◉':'◎'});
  lock.addEventListener('click',showLogin);

  /* ===== СМЕНА ПАРОЛЯ ===== */
  const openAuthChangeBtn = document.getElementById('openAuthChangeBtn');
  const authVerifyOverlay = document.getElementById('authVerifyOverlay');
  const authVerifyUser = document.getElementById('authVerifyUser');
  const authVerifyPass = document.getElementById('authVerifyPass');
  const authVerifyError = document.getElementById('authVerifyError');
  const authVerifyOkBtn = document.getElementById('authVerifyOkBtn');
  const authVerifyCancelBtn = document.getElementById('authVerifyCancelBtn');

  const authChangeOverlay = document.getElementById('authChangeOverlay');
  const authNewUser = document.getElementById('authNewUser');
  const authNewPass = document.getElementById('authNewPass');
  const authNewPass2 = document.getElementById('authNewPass2');
  const authChangeError = document.getElementById('authChangeError');
  const authChangeSaveBtn = document.getElementById('authChangeSaveBtn');
  const authChangeCancelBtn = document.getElementById('authChangeCancelBtn');

  function openVerifyModal(){
    authVerifyUser.value=''; authVerifyPass.value=''; authVerifyError.classList.remove('show');
    authVerifyOverlay.classList.add('show'); setTimeout(()=>authVerifyUser.focus(),50);
  }
  function closeVerifyModal(){ authVerifyOverlay.classList.remove('show'); }
  function openChangeModal(){
    authNewUser.value=''; authNewPass.value=''; authNewPass2.value=''; authChangeError.classList.remove('show');
    authChangeOverlay.classList.add('show'); setTimeout(()=>authNewUser.focus(),50);
  }
  function closeChangeModal(){ authChangeOverlay.classList.remove('show'); }

  if(openAuthChangeBtn){
    openAuthChangeBtn.addEventListener('click', ()=>{
      document.getElementById('settingsOverlay').classList.remove('show');
      openVerifyModal();
    });
  }
  authVerifyCancelBtn.addEventListener('click', closeVerifyModal);
  authVerifyOkBtn.addEventListener('click', ()=>{
    const u = authVerifyUser.value.trim().toLowerCase();
    const p = authVerifyPass.value;
    if(u === creds.user.trim().toLowerCase() && p === creds.pass){
      closeVerifyModal(); openChangeModal();
    }else{
      authVerifyError.textContent='Неверный логин или пароль'; authVerifyError.classList.add('show');
      authVerifyPass.value=''; authVerifyPass.focus();
    }
  });
  authChangeCancelBtn.addEventListener('click', closeChangeModal);
  authChangeSaveBtn.addEventListener('click', ()=>{
    const nu = authNewUser.value.trim();
    const np = authNewPass.value;
    const np2 = authNewPass2.value;
    if(!nu || !np || !np2){ authChangeError.textContent='Заполните все поля'; authChangeError.classList.add('show'); return; }
    if(np !== np2){ authChangeError.textContent='Пароли не совпадают'; authChangeError.classList.add('show'); return; }
    creds = { user: nu, pass: np };
    setCreds(nu, np);
    authChangeError.classList.remove('show'); closeChangeModal();
    if(typeof showToast === 'function') showToast('Логин и пароль успешно изменены');
  });

  showLogin();
})();
</script>
</body>
</html>