function renderReceipt() {
  const rItems = document.getElementById('rItems');
  const totalsWrap = document.getElementById('rTotalsWrap');
  const printBtn = document.getElementById('printBtn');
  const shell = document.getElementById('receiptShell');

  if (!currentOrder.length) {
    rItems.innerHTML = '<div class="r-empty">Чек пуст.<br>Нажмите на позицию слева.</div>';
    totalsWrap.style.display = 'none';
    printBtn.disabled = true;
    printBtn.classList.remove('btn-sealed');
    printBtn.textContent = '🖨 Печать / Пробить';
    shell.classList.remove('sealed');
    isOrderSealed = false;
    return;
  }

  let subtotal = 0;
  rItems.innerHTML = '';
  currentOrder.forEach((item) => {
    subtotal += item.price * item.qty;
    const row = document.createElement('div');
    row.className = 'r-row';
    row.innerHTML = `<div><b>${item.name}</b> x${item.qty}</div><div>${(item.price * item.qty).toLocaleString()} сум</div>`;
    rItems.appendChild(row);
  });

  const serviceFee = Math.round(subtotal * 0.10); // 10% ОБСЛУЖИВАНИЕ
  const total = subtotal + serviceFee;

  document.getElementById('rSubTotal').textContent = subtotal.toLocaleString() + ' сум';
  document.getElementById('rServiceTotal').textContent = serviceFee.toLocaleString() + ' сум';
  document.getElementById('rTotal').textContent = total.toLocaleString() + ' сум';
  totalsWrap.style.display = 'block';

  if (!isOrderSealed) {
    printBtn.disabled = false;
  }
}

