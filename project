  const dishName = cat.items[index].name;
  cat.items.splice(index, 1);
  saveMenuToStorage();
  renderManageList();
  showToast(`✅ Ячейка "${dishName}" успешно удалена`);
}

async function deleteCategory(catKey) {
  const cat = menu[catKey];
  if (!cat) return;
  const count = (cat.items || []).length;
  const ok = await askConfirm({
    title: 'Удалить категорию?',
    text: `Категория <b>${cat.name}</b> и все её ячейки (${count}) будут удалены безвозвратно.`,
    okText: 'Да, удалить'
  });
  if (!ok) return;

  const catName = cat.name;
  delete menu[catKey];

  const block = getCategoryBlock(catKey);
  if (block) {
    delete layoutData[block.id];
    safeSetItem('my_layout_data', JSON.stringify(layoutData));
    block.remove();
  }

  if (activeCatId === catKey) {
    activeCatId = Object.keys(menu)[0] || null;
    document.querySelectorAll('.tabbtn').forEach(b => b.classList.remove('active'));
    const nextBlock = activeCatId ? getCategoryBlock(activeCatId) : null;    if (nextBlock) {
